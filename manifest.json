{
  "manifest_version": 3,
  "name": "Фильтр курсов СДО (Московский Политех)",
  "version": "1.0.0",
  "description": "Скрывает лишние и старые дисциплины на странице «Мои курсы» СДО (online.mospolytech.ru): галочкой прямо в списке или по названию.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Фильтр курсов СДО",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://online.mospolytech.ru/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ]
}
